// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum InvitationEmailStatus {
  NOT_SENT
  SUBMITTED
  FAILED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum GeocodingStatus {
  NOT_GEOCODED
  GEOCODED
  FAILED
}

enum GeocodingProvider {
  GEOAPIFY
}

enum RoutingStatus {
  NOT_CALCULATED
  CALCULATED
  FAILED
}

enum RoutingProvider {
  GEOAPIFY
}

enum RoutingMode {
  DRIVE
}

enum RoutingTrafficModel {
  FREE_FLOW
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_QUEUE
  CALLED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentCancellationReason {
  PATIENT_REQUEST
  PATIENT_ILLNESS
  PATIENT_EMERGENCY
  DOCTOR_UNAVAILABLE
  CLINIC_REQUEST
  SCHEDULING_CONFLICT
  TRANSPORTATION_ISSUE
  DUPLICATE_BOOKING
  RESCHEDULED_ELSEWHERE
  OTHER
}

enum AppointmentNoShowReason {
  FORGOT_APPOINTMENT
  UNREACHABLE
  TRANSPORTATION_ISSUE
  PATIENT_EMERGENCY
  SCHEDULING_MISUNDERSTANDING
  NO_CONFIRMATION
  OTHER
  UNKNOWN
}

enum QueueStatus {
  WAITING
  ARRIVED
  CALLED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum PredictionGenerationSource {
  APPOINTMENT_CREATION
  BACKFILL
  LEGACY_EXISTING
  APPOINTMENT_RESCHEDULED
  PATIENT_HISTORY_CHANGED
  TRAVEL_DISTANCE_CHANGED
}

enum PredictionRefreshStatus {
  PENDING
  PROCESSING
  COMPLETED
  RETRYABLE_FAILURE
  NEEDS_ATTENTION
}

enum BookingSource {
  RECEPTION
  PHONE
  WEB
  WALK_IN
}

enum AppointmentActivityType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  PATIENT_ARRIVED
  ENTERED_QUEUE
  PATIENT_CALLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_CANCELLED
  APPOINTMENT_NO_SHOW
  APPOINTMENT_RESCHEDULED
}

enum AppointmentActualOutcome {
  PENDING
  ATTENDED
  NO_SHOW
  CANCELLED
  EXCLUDED
}

enum AppointmentOutcomeSource {
  ARRIVAL_EVIDENCE
  COMPLETED_STATUS
  NO_SHOW_STATUS
  CANCELLATION_STATUS
  UNRESOLVED
  CONFLICTING_EVIDENCE
}

enum PredictionFeedbackUsefulness {
  USEFUL
  NOT_USEFUL
  UNSURE
}

enum PredictionFeedbackAction {
  CONTACTED_PATIENT
  REMINDER_SENT
  ATTENDANCE_CONFIRMED
  RESCHEDULED_APPOINTMENT
  MONITORED_APPOINTMENT
  NO_ACTION
  OTHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Clinic {
  id                      String             @id @default(uuid()) @db.Uuid
  name                    String
  slug                    String             @unique
  phone                   String?
  email                   String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  country                 String             @default("India")
  pincode                 String?
  latitude                Float?
  longitude               Float?
  geocodingStatus         GeocodingStatus    @default(NOT_GEOCODED)
  geocodingProvider       GeocodingProvider?
  geocodingConfidence     Float?
  geocodingResultType     String?
  geocodingMatchType      String?
  geocodingPlaceId        String?
  geocodedAddress         String?
  geocodedAt              DateTime?
  geocodingSourceHash     String?
  geocodingAttemptId      String?
  timezone                String             @default("Asia/Kolkata")
  openingTime             String             @default("09:00")
  closingTime             String             @default("18:00")
  slotDurationMinutes     Int                @default(15)
  bufferMinutes           Int                @default(0)
  lateArrivalGraceMinutes Int                @default(15)
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  users                         User[]
  doctorClinics                 DoctorClinic[]
  patientClinics                PatientClinic[]
  appointments                  Appointment[]
  queueEntries                  QueueEntry[]
  noShowPredictions             NoShowPrediction[]
  predictionRefreshWork         PredictionRefreshWork[]
  appointmentActivities         AppointmentActivity[]
  appointmentPredictionOutcomes AppointmentPredictionOutcome[]
  staffInvitations              StaffInvitation[]
  lifecycleEvents               LifecycleEvent[]

  @@index([isActive])
  @@index([city])
  @@map("clinics")
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  clerkUserId String     @unique
  fullName    String
  email       String     @unique
  phone       String?
  role        UserRole   @default(STAFF)
  status      UserStatus @default(INVITED)
  clinicId    String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  clinic                   Clinic?               @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAppointments      Appointment[]         @relation("AppointmentCreatedBy")
  appointmentActivities    AppointmentActivity[] @relation("AppointmentActivityActor")
  staffInvitationsSent     StaffInvitation[]     @relation("StaffInvitationInvitedBy")
  staffInvitationsAccepted StaffInvitation[]     @relation("StaffInvitationAcceptedBy")
  lifecycleEvents          LifecycleEvent[]      @relation("LifecycleEventActor")
  predictionFeedback       PredictionFeedback[]

  @@index([clinicId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model StaffInvitation {
  id                     String                @id @default(uuid()) @db.Uuid
  clinicId               String                @db.Uuid
  email                  String
  tokenHash              String                @unique
  status                 StaffInvitationStatus @default(PENDING)
  invitedByUserId        String                @db.Uuid
  acceptedByUserId       String?               @db.Uuid
  expiresAt              DateTime
  acceptedAt             DateTime?
  revokedAt              DateTime?
  emailStatus            InvitationEmailStatus @default(NOT_SENT)
  emailSubmittedAt       DateTime?
  emailProviderMessageId String?
  emailAttemptId         String?
  emailAttemptStartedAt  DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  clinic     Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  invitedBy  User   @relation("StaffInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy User?  @relation("StaffInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, status])
  @@index([clinicId, email])
  @@index([email, status])
  @@index([expiresAt])
  @@map("staff_invitations")
}

model LifecycleEvent {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @db.Uuid
  actorUserId String   @db.Uuid
  entityType  String
  entityId    String   @db.Uuid
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  actor  User   @relation("LifecycleEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("lifecycle_events")
}

model Doctor {
  id                 String   @id @default(uuid()) @db.Uuid
  fullName           String
  specialization     String?
  qualification      String?
  registrationNumber String?
  phone              String?
  email              String?
  gender             Gender?
  experienceYears    Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  doctorClinics DoctorClinic[]
  appointments  Appointment[]
  queueEntries  QueueEntry[]

  @@index([isActive])
  @@index([specialization])
  @@map("doctors")
}

model DoctorClinic {
  id              String   @id @default(uuid()) @db.Uuid
  doctorId        String   @db.Uuid
  clinicId        String   @db.Uuid
  isActive        Boolean  @default(true)
  displayName     String?
  consultationFee Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctor              Doctor                     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic              Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  availabilityPeriods DoctorAvailabilityPeriod[]

  @@unique([doctorId, clinicId])
  @@index([doctorId])
  @@index([clinicId])
  @@index([isActive])
  @@map("doctor_clinics")
}

model DoctorAvailabilityPeriod {
  id             String   @id @default(uuid()) @db.Uuid
  doctorClinicId String   @db.Uuid
  weekday        Weekday
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctorClinic DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)

  @@unique([doctorClinicId, weekday, startTime, endTime])
  @@index([doctorClinicId, weekday, startTime])
  @@map("doctor_availability_periods")
}

model Patient {
  id                    String             @id @default(uuid()) @db.Uuid
  fullName              String
  phone                 String
  email                 String?
  gender                Gender?
  dateOfBirth           DateTime?
  age                   Int?
  /// Deprecated transitional compatibility field. Structured location fields are authoritative.
  address               String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  country               String?
  pincode               String?
  latitude              Float?
  longitude             Float?
  geocodingStatus       GeocodingStatus    @default(NOT_GEOCODED)
  geocodingProvider     GeocodingProvider?
  geocodingConfidence   Float?
  geocodingResultType   String?
  geocodingMatchType    String?
  geocodingPlaceId      String?
  geocodedAddress       String?
  geocodedAt            DateTime?
  geocodingSourceHash   String?
  geocodingAttemptId    String?
  emergencyContactName  String?
  emergencyContactPhone String?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  patientClinics        PatientClinic[]
  appointments          Appointment[]
  queueEntries          QueueEntry[]
  noShowPredictions     NoShowPrediction[]
  predictionRefreshWork PredictionRefreshWork[]

  @@index([phone])
  @@index([fullName])
  @@index([isActive])
  @@map("patients")
}

model PatientClinic {
  id                         String               @id @default(uuid()) @db.Uuid
  patientId                  String               @db.Uuid
  clinicId                   String               @db.Uuid
  totalAppointments          Int                  @default(0)
  totalCompletedVisits       Int                  @default(0)
  totalNoShows               Int                  @default(0)
  totalLateArrivals          Int                  @default(0)
  lastVisitAt                DateTime?
  notes                      String?
  distanceFromClinicKm       Decimal?             @db.Decimal(6, 2)
  estimatedTravelTimeMinutes Int?
  routingStatus              RoutingStatus        @default(NOT_CALCULATED)
  routingProvider            RoutingProvider?
  routingMode                RoutingMode?
  routingTrafficModel        RoutingTrafficModel?
  routedAt                   DateTime?
  routingSourceHash          String?
  routingAttemptId           String?
  isActive                   Boolean              @default(true)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([patientId, clinicId])
  @@index([clinicId])
  @@index([patientId])
  @@index([isActive])
  @@map("patient_clinics")
}

model Appointment {
  id                      String                         @id @default(uuid()) @db.Uuid
  clinicId                String                         @db.Uuid
  doctorId                String                         @db.Uuid
  patientId               String                         @db.Uuid
  createdByUserId         String                         @db.Uuid
  scheduledAt             DateTime
  durationMinutes         Int                            @default(15)
  status                  AppointmentStatus              @default(SCHEDULED)
  bookingSource           BookingSource                  @default(RECEPTION)
  reason                  String?
  notes                   String?
  cancellationReason      AppointmentCancellationReason?
  cancellationNote        String?
  noShowReason            AppointmentNoShowReason?
  noShowNote              String?
  arrivedAt               DateTime?
  arrivalOffsetMinutes    Int?
  isLateArrival           Boolean?
  lateArrivalGraceMinutes Int?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  clinic            Clinic                        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor            Doctor                        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient           Patient                       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy         User                          @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  queueEntry        QueueEntry?
  noShowPredictions NoShowPrediction[]
  activities        AppointmentActivity[]
  predictionOutcome AppointmentPredictionOutcome?

  @@index([clinicId, scheduledAt])
  @@index([clinicId, doctorId, scheduledAt])
  @@index([clinicId, patientId, scheduledAt])
  @@index([clinicId, status])
  @@map("appointments")
}

// One authoritative appointment-level result; prediction runs remain immutable
// and join to this record through their existing appointmentId relationship.
model AppointmentPredictionOutcome {
  id                String                   @id @default(uuid()) @db.Uuid
  appointmentId     String                   @unique @db.Uuid
  clinicId          String                   @db.Uuid
  actualOutcome     AppointmentActualOutcome @default(PENDING)
  actualNoShow      Boolean?
  outcomeSource     AppointmentOutcomeSource @default(UNRESOLVED)
  outcomeRecordedAt DateTime?
  evidenceAt        DateTime?
  exclusionReason   String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([clinicId, actualOutcome, outcomeRecordedAt])
  @@map("appointment_prediction_outcomes")
}

model AppointmentActivity {
  id            String                  @id @default(uuid()) @db.Uuid
  appointmentId String                  @db.Uuid
  clinicId      String                  @db.Uuid
  actorUserId   String?                 @db.Uuid
  type          AppointmentActivityType
  occurredAt    DateTime
  metadata      Json?
  createdAt     DateTime                @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  actor       User?       @relation("AppointmentActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId, occurredAt])
  @@index([clinicId, occurredAt])
  @@map("appointment_activities")
}

model QueueEntry {
  id            String      @id @default(uuid()) @db.Uuid
  clinicId      String      @db.Uuid
  appointmentId String      @unique @db.Uuid
  doctorId      String      @db.Uuid
  patientId     String      @db.Uuid
  position      Int
  status        QueueStatus @default(WAITING)
  queuedAt      DateTime    @default(now())
  calledAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([clinicId, status])
  @@index([clinicId, doctorId, position])
  @@index([clinicId, queuedAt])
  @@map("queue_entries")
}

model NoShowPrediction {
  id                   String                     @id @default(uuid()) @db.Uuid
  appointmentId        String                     @db.Uuid
  clinicId             String                     @db.Uuid
  patientId            String                     @db.Uuid
  featureSchemaVersion String?
  featureSnapshot      Json?
  ruleVersion          String?
  generationSource     PredictionGenerationSource @default(LEGACY_EXISTING)
  runKey               String?                    @unique
  riskLevel            RiskLevel
  score                Int
  reasons              Json
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  appointment Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  clinic      Clinic               @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient     Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  feedback    PredictionFeedback[]

  @@index([appointmentId, createdAt])
  @@index([clinicId])
  @@index([patientId])
  @@map("no_show_predictions")
}

model PredictionFeedback {
  id                     String                       @id @default(uuid()) @db.Uuid
  predictionId           String                       @db.Uuid
  staffUserId            String                       @db.Uuid
  usefulness             PredictionFeedbackUsefulness
  actionTaken            PredictionFeedbackAction
  note                   String?
  recommendationSnapshot Json
  recommendationVersion  String
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  prediction NoShowPrediction @relation(fields: [predictionId], references: [id], onDelete: Restrict)
  staffUser  User             @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  @@unique([predictionId, staffUserId])
  @@index([staffUserId, createdAt])
  @@map("prediction_feedback")
}

// A coalesced, clinic-scoped request to refresh future appointment predictions.
// It is deliberately separate from NoShowPrediction so prediction runs remain
// immutable audit records rather than mutable job state.
model PredictionRefreshWork {
  id                String                     @id @default(uuid()) @db.Uuid
  clinicId          String                     @db.Uuid
  patientId         String                     @db.Uuid
  requestedRevision Int                        @default(1)
  processedRevision Int                        @default(0)
  latestTrigger     PredictionGenerationSource
  status            PredictionRefreshStatus    @default(PENDING)
  requestedAt       DateTime                   @default(now())
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  attemptCount      Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now())
  lastErrorCode     String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([clinicId, patientId])
  @@index([status, nextAttemptAt])
  @@index([clinicId, patientId, requestedRevision])
  @@map("prediction_refresh_work")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_QUEUE
  CALLED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  ARRIVED
  CALLED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum BookingSource {
  RECEPTION
  PHONE
  WEB
  WALK_IN
}

model Clinic {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String
  slug                String          @unique
  phone               String?
  email               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  country             String          @default("India")
  pincode             String?
  timezone            String          @default("Asia/Kolkata")
  openingTime         String          @default("09:00")
  closingTime         String          @default("18:00")
  slotDurationMinutes Int             @default(15)
  bufferMinutes       Int             @default(0)
  isActive            Boolean         @default(true)
  users               User[]
  doctorClinics       DoctorClinic[]
  patientLinks        PatientClinic[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([isActive])
  @@index([city])
  @@map("clinics")
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  clerkUserId String     @unique
  fullName    String
  email       String     @unique
  phone       String?
  role        UserRole   @default(STAFF)
  status      UserStatus @default(INVITED)
  clinicId    String?    @db.Uuid
  clinic      Clinic?    @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([clinicId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Doctor {
  id                 String         @id @default(uuid()) @db.Uuid
  fullName           String
  specialization     String?
  qualification      String?
  registrationNumber String?
  phone              String?
  email              String?
  gender             Gender?
  experienceYears    Int?
  isActive           Boolean        @default(true)
  doctorClinics      DoctorClinic[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([isActive])
  @@index([specialization])
  @@map("doctors")
}

model DoctorClinic {
  id              String   @id @default(uuid()) @db.Uuid
  doctorId        String   @db.Uuid
  clinicId        String   @db.Uuid
  isActive        Boolean  @default(true)
  displayName     String?
  consultationFee Decimal? @db.Decimal(10, 2)
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([doctorId, clinicId])
  @@index([doctorId])
  @@index([clinicId])
  @@index([isActive])
  @@map("doctor_clinics")
}

model Patient {
  id                    String    @id @default(uuid()) @db.Uuid
  fullName              String
  phone                 String
  email                 String?
  gender                Gender?
  dateOfBirth           DateTime?
  age                   Int?
  address               String?
  city                  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  patientClinics        PatientClinic[]

  @@index([phone])
  @@index([fullName])
  @@index([isActive])
  @@map("patients")
}

model PatientClinic {
  id                   String    @id @default(uuid()) @db.Uuid
  patientId            String    @db.Uuid
  clinicId             String    @db.Uuid
  totalAppointments    Int       @default(0)
  totalNoShows         Int       @default(0)
  totalLateArrivals    Int       @default(0)
  lastVisitAt          DateTime?
  notes                String?
  distanceFromClinicKm Decimal?  @db.Decimal(6, 2)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([patientId, clinicId])
  @@index([clinicId])
  @@index([patientId])
  @@map("patient_clinics")
}

NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use the unique Neon development branch host when database names are shared.
SEED_DATABASE_TARGET=ep-your-development-branch.neon.tech
SEED_DATABASE_ALLOWLIST=ep-your-development-branch.neon.tech
SEED_PROFILE=demo
SEED_ANCHOR_DATE=2026-10-16
# Optional real Clerk development identities. Never invent these values.
SEED_ADMIN_CLERK_USER_ID=user_your_development_admin_id
SEED_STAFF_CLERK_USER_ID=user_your_development_staff_id
# Only set when intentionally removing exact rows owned by this seed.
# SEED_CLEANUP_CONFIRMATION=I_UNDERSTAND_SEED_OWNED_ROWS_ONLY
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_if_used
GEOAPIFY_API_KEY=your_geoapify_api_key
CLIENT_URL=http://localhost:5173
LOCAL_CLIENT_URL=http://localhost:5173

{
    "name": "@pravaah/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "rm -rf dist && prisma generate && tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "check": "tsc --noEmit",
        "lint": "echo \"server lint not configured yet\"",
        "test": "vitest run",
        "seed": "prisma db seed",
        "seed:demo": "prisma db seed",
        "prisma:generate": "prisma generate",
        "prisma:migrate:deploy": "prisma migrate deploy"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@clerk/express": "^2.1.31",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "pg": "^8.21.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.12.4",
        "@types/pg": "^8.20.0",
        "prisma": "^7.8.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    }
}

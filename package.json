{
    "name": "pravaah",
    "version": "0.2.0",
    "private": true,
    "description": "Pravaah is a clinic flow management system for appointments, daily queues, and explainable rule-based no-show assistance.",
    "workspaces": [
        "apps/web",
        "apps/server",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspaces",
        "dev:web": "npm run dev -w apps/web",
        "dev:server": "npm run dev -w apps/server",
        "build": "npm run build --workspaces",
        "build:web": "npm run build -w apps/web",
        "build:server": "npm run build -w apps/server",
        "lint": "npm run lint --workspaces",
        "format": "prettier --write .",
        "check": "npm run build && npm run lint",
        "test:web": "npm run test -w apps/web",
        "test:server": "npm run test -w apps/server",
        "seed:demo": "npm run seed:demo -w apps/server"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/garvitsingh171/pravaah.git"
    },
    "keywords": [
        "clinic",
        "flow management",
        "appointments",
        "no-shows",
        "patient queues",
        "queue-management",
        "healthcare",
        "typescript"
    ],
    "author": "Garvit Singh",
    "license": "MIT",
    "devDependencies": {
        "prettier": "^3.0.0"
    },
    "bugs": {
        "url": "https://github.com/garvitsingh171/pravaah/issues"
    },
    "homepage": "https://github.com/garvitsingh171/pravaah#readme"
}

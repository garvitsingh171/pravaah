# Application
NODE_ENV=development

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
# Optional MVP/demo fallback. Put this in apps/web/.env and restart Vite after changes.
VITE_DEFAULT_CLINIC_ID=00000000-0000-4000-8000-000000000000
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Backend
PORT=5000
CLIENT_URL=http://localhost:5173
LOCAL_CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Clerk
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_if_used

# Local seed/bootstrap
# Recommended when running the local demo seed. Copy this from the Clerk dashboard user profile.
# If omitted, the seed creates a placeholder internal Admin user that cannot sign in
# until this value is replaced with a real development Clerk user ID.
SEED_CLERK_USER_ID=user_xxxxxxxxxxxxxxxxx
# Optional local alias accepted by the seed when SEED_CLERK_USER_ID is not set.
DEV_CLERK_USER_ID=user_xxxxxxxxxxxxxxxxx
# Optional Staff demo user. If omitted, the seed creates an INVITED placeholder Staff user.
SEED_STAFF_CLERK_USER_ID=user_xxxxxxxxxxxxxxxxx
# Optional seed overrides.
SEED_USER_EMAIL=local-admin@pravaah.local
SEED_USER_FULL_NAME=Local Pravaah Admin
SEED_STAFF_USER_EMAIL=local-staff@pravaah.local
SEED_STAFF_USER_FULL_NAME=Local Pravaah Staff
# Must be PostgreSQL UUID-shaped. Put this in apps/server/.env.
SEED_DEMO_CLINIC_ID=00000000-0000-4000-8000-000000000000
